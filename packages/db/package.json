    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@rocket/typescript-config": "workspace:*",
    "@types/node": "^22.18.13",
    "@types/pg": "^8.15.6",
    "better-auth": "^1.3.34",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
