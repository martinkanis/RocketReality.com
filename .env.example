# Lokální vývoj — hodnoty odpovídají docker/docker-compose.yml
NODE_ENV=development
DATABASE_URL=postgres://rocket:rocket@localhost:5442/rocketreality
APP_URL=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="RocketReality <info@rocketreality.cz>"

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=rocketreality
S3_ACCESS_KEY_ID=rocket
S3_SECRET_ACCESS_KEY=rocketreality

AUTH_SECRET=dev-secret-change-me-in-production

# Platby: v1 vše zdarma. Zapnutí Stripe = 'stripe' + klíče níže.
PAYMENTS_PROVIDER=free
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
S3_FORCE_PATH_STYLE=true
